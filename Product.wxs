<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Media Downloader Deluxe" Manufacturer="Dominik Reinartz" Version="1.3.1" UpgradeCode="82934c4b-0e42-4cf6-85bc-15b1e57efe23">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <Feature Id="FilesFeature">
      <ComponentGroupRef Id="Main" />
    </Feature>
    <Feature Id="ShortcutFeature" Title="Shortcuts" Level="1">
      <ComponentGroupRef Id="ShortcutGroup" />
    </Feature>
    <Media Id="1" Cabinet="mdd.cab" EmbedCab="yes" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="!(bind.Property.ProductName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Main" Directory="INSTALLFOLDER">
      <Component>
        <File Source="Media Downloader Deluxe.exe" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutGroup">
      <Component Id="ApplicationShortcutDesktop" Guid="ed8c8700-5917-4f03-904e-e60926532343" Directory="DesktopFolder">
        <Shortcut Id="ApplicationDesktopShortcut"
          Name="!(bind.Property.ProductName)"
          Target="[INSTALLFOLDER]Media Downloader Deluxe.exe"
          WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="DesktopFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
          Key="Software\Media Downloader Deluxe"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes"/>
      </Component>

      <Component Id="ApplicationShortcutMenu" Guid="3b209251-b7e6-4975-861a-2951a8201ff2" Directory="ProgramMenuFolder">
        <Shortcut Id="ApplicationStartMenuShortcut"
          Name="!(bind.Property.ProductName)"
          Target="[INSTALLFOLDER]Media Downloader Deluxe.exe"
          WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ProgramMenuFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
          Key="Software\Media Downloader Deluxe"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes"/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
